{
  "name": "openapi-operation-migrator",
  "version": "0.2.1",
  "description": "Preview and safely migrate renamed OpenAPI operation calls in TypeScript and Vue projects",
  "type": "module",
  "bin": {
    "opid-migrate": "./src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/cli.js && node --check src/spec.js && node --check src/scan.js && node --check src/report.js && node --check src/generators.js && node --check src/imports.js",
    "test:package": "node scripts/package-smoke.js"
  },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.28.0",
    "@vue/compiler-sfc": "^3.5.0",
    "camelcase": "6.3.0",
    "typescript": "5.9.3",
    "yaml": "^2.8.0"
  },
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lix059/openapi-operation-migrator.git"
  },
  "bugs": {
    "url": "https://github.com/lix059/openapi-operation-migrator/issues"
  }
}
